# =====================================================================
# Reinigingsdokter outreach — example configuration
# Copy to `.env` and adjust. NEVER commit a real `.env` to Git.
# =====================================================================

# --- Database (PostgreSQL) -------------------------------------------
# Must match the password you set for the postgres service below.
DATABASE_URL=postgresql+psycopg://outreach:change-me@localhost:5432/outreach
POSTGRES_PASSWORD=change-me

# --- Security / dashboard login --------------------------------------
# Generate a long random value (e.g. `openssl rand -hex 32`).
APP_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Company identity (sender / footer) ------------------------------
COMPANY_NAME=Reinigingsdokter
COMPANY_WEBSITE=https://www.reinigingsdokter.nl
COMPANY_ADDRESS=
COMPANY_EMAIL=

# --- Sending behaviour ------------------------------------------------
# DRY_RUN=true generates everything but sends nothing.
DRY_RUN=true
# LIVE_SEND_ENABLED must be true as an extra gate before real sending.
LIVE_SEND_ENABLED=false
# ENABLE_AUTOMATION runs the discovery/send pipeline in the worker.
ENABLE_AUTOMATION=false
DAILY_EMAIL_LIMIT=25
HOURLY_EMAIL_LIMIT=5
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=180
MAX_FOLLOWUPS=1
MIN_LEAD_SCORE=65
# Comma separated service regions used when a campaign has no region/city.
SERVICE_REGIONS=Zuid-Holland

# --- SMTP (only needed for live sending) ------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Gmail API via OAuth refresh token (alternative to SMTP) ----------
GMAIL_ACCESS_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- IMAP inbox for replies / bounces (optional) ----------------------
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=

# --- LLM (optional; deterministic Dutch fallback is used otherwise) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Discovery (OpenStreetMap Overpass / Nominatim) --------------------
# Configure your own Overpass instance for production volume.
DISCOVERY_API_URL=
DISCOVERY_API_KEY=
# Acknowledge that you comply with the data source terms of use.
DISCOVERY_API_TERMS_ACCEPTED=true
